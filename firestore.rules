rules_version = '2';
// TESTING RULES: anyone with the page can read and write these collections.
// Before real use, replace "if true" with "if request.auth != null" (and add sign-in).
service cloud.firestore {
  match /databases/{database}/documents {
    match /edits/{doc} { allow read, write: if true; }
    match /meta/{doc}  { allow read, write: if true; }
    match /{coll}/{doc} {
      allow read, write: if coll.matches('ds_.*');
    }
  }
}
